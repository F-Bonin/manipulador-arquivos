# Ambiente de execução (local, staging, production)
APP_ENV=local

# Nível de detalhe dos logs (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Tamanho máximo de upload em megabytes
MAX_UPLOAD_MB=200

# Pastas de trabalho (caminhos relativos à raiz do projeto)
LIBRARY_DIR=data/library
UPLOADS_DIR=data/uploads
OUTPUT_DIR=data/output